// Entry point compiled by build.rs. Every top-level window of the shell is
// exported from here so Rust gets a typed handle for each one.
export { Theme, Palette, Tokens } from "theme.slint";
export { Shell, Workspace, SysStats, MediaInfo, ForecastDay, Weather, Status, CalendarDay, AppEntry, UserInfo, InfoRow, WallpaperEntry, Recording, UiConfig, SchemeCard, PickerEntry, PluginWidget, NotifGroup, NotifItem } from "state.slint";
export { BorderWindow } from "modules/border.slint";
export { BarWindow } from "modules/bar.slint";
export { DashboardWindow } from "modules/dashboard.slint";
export { LauncherWindow } from "modules/launcher.slint";
export { UtilitiesWindow } from "modules/utilities.slint";
export { SessionWindow } from "modules/session.slint";
export { SidebarWindow } from "modules/sidebar.slint";
export { SettingsWindow } from "modules/settings.slint";
export { PopoutWindow } from "modules/popouts.slint";
export { ConfettiWindow, ConfettiPiece } from "modules/confetti.slint";
