// Shared state + the single action bus between Slint and Rust.
// Rust pushes data in; the UI never talks to the OS directly, it only emits
// `Shell.action(id, arg)` / `Shell.set-config(path, json)`.

// `icons-before` / `occupied-before` are running totals over the previous
// workspaces; the bar uses them to place slots of different heights.
export struct Workspace { id: int, occupied: bool, name: string, icons: [image], icon-count: int, icons-before: int, occupied-before: int }

export struct SysStats {
    cpu: float, cpu-name: string, cpu-temp: string, cpu-temp-help: string,
    gpu: float, gpu-name: string, gpu-temp: string, has-gpu: bool,
    mem-used: string, mem-total: string, mem: float,
    disk-name: string, disk-used: string, disk-total: string, disk: float, disk-count: int,
    net-down: string, net-up: string, net-total-down: string, net-total-up: string,
    net-down-path: string, net-up-path: string,
}

export struct MediaInfo {
    available: bool, playing: bool,
    title: string, artist: string, album: string, app: string,
    position: float, length: float, position-text: string, length-text: string,
    cover: image, has-cover: bool,
}

export struct ForecastDay { day: string, icon: string, max: string, min: string }

export struct Weather {
    available: bool, city: string, temp: string, feels: string, icon: string,
    description: string, humidity: string, wind: string, precipitation: string,
    sunrise: string, sunset: string,
    forecast: [ForecastDay],
}

export struct Status {
    volume: float, muted: bool, mic-volume: float, mic-muted: bool,
    online: bool, wifi: bool, wifi-strength: int, network-name: string,
    bluetooth: bool, bluetooth-available: bool, wifi-available: bool,
    battery-present: bool, battery: float, charging: bool,
}

export struct CalendarDay { day: int, current-month: bool, today: bool }

// `emoji` set = an emoji row (rendered as text); `glyph` = a Material icon.
export struct AppEntry { id: int, name: string, description: string, icon: image, has-icon: bool, is-action: bool, glyph: string, emoji: string }

export struct UserInfo { name: string, initial: string, host: string, uptime: string, os: string, avatar: image, has-avatar: bool }

export struct InfoRow { label: string, value: string }

export struct WallpaperEntry { path: string, name: string, thumb: image, current: bool }

export struct Recording { name: string, path: string }

export struct Place { name: string, detail: string, country-code: string, coords: string }

export struct AudioDevice { id: string, name: string, default: bool }

export struct BtDevice { id: string, name: string, icon: string, connected: bool, audio: bool, busy: bool }

// A plugin widget (see services/plugins.rs). `index` is what
// `plugin-click` takes; `tone` is "" | good | warning | critical.
export struct PluginWidget {
    index: int, id: string, name: string, icon: string, text: string, tooltip: string,
    tone: string, percentage: float, has-percentage: bool, error: string, enabled: bool, clickable: bool,
}

// One option of a live-preview picker (scheme, variant, opacity).
export struct PickerEntry { id: string, label: string, sublabel: string, bg: color, fg: color, c1: color, c2: color, c3: color, alpha: float, current: bool }

export struct SchemeCard { id: string, label: string, dark: bool, bg: color, fg: color, c1: color, c2: color, c3: color, current: bool }

// Typed subset of shell.json the UI needs to lay itself out.
export struct UiConfig {
    bar-persistent: bool,
    bar-show-workspaces: bool,
    bar-workspaces-shown: int,
    bar-active-trail: bool,
    bar-show-active-window: bool,
    bar-show-clock: bool,
    bar-show-status: bool,
    bar-show-power: bool,
    bar-show-audio: bool,
    bar-show-network: bool,
    bar-show-bluetooth: bool,
    bar-show-battery: bool,
    clock-12h: bool,
    dashboard-enabled: bool,
    dashboard-show-on-hover: bool,
    launcher-max-shown: int,
    launcher-action-prefix: string,
    clipboard-history: bool,
    clipboard-paste: bool,
    use-fahrenheit: bool,
    weather-location: string,
    weather-location-name: string,
    wallpaper-enabled: bool,
    wallpaper-path: string,
    scheme-variant: string,
    scheme-mode: string,
    scheme-name: string,
    smart-scheme: bool,
    anim-scale: float,
    blur: bool,
    super-launcher: bool,
    wallpaper-repo: string,
    autostart: bool,
    komorebi-enabled: bool,
    komorebi-autostart: bool,
    komorebi-borders: bool,
    komorebi-gap-inner: float,
    komorebi-gap-outer: float,
    komorebi-border-width: float,
    komorebi-animations: bool,
    language: string,
    border-thickness: float,
    border-rounding: float,
    rounding-scale: float,
    font-scale: float,
    transparency: bool,
    base-alpha: float,
    layer-alpha: float,
    config-path: string,
    // windows.performance: mode auto|on|off; `perf-active` is why effects are
    // reduced right now ("" | forced | battery | fullscreen).
    perf-mode: string,
    perf-on-battery: bool,
    perf-on-fullscreen: bool,
    perf-active: string,
}

export global Shell {
    // clock
    in property <string> hours: "00";
    in property <string> minutes: "00";
    in property <string> ampm: "";
    in property <string> date-long;
    in property <string> date-short;
    in property <string> weekday;
    // calendar
    in property <string> calendar-title;
    in property <[CalendarDay]> calendar;
    // workspaces / windows
    in property <[Workspace]> workspaces;
    in property <int> active-workspace: 1;
    // +1 / -1: where the last switch went (drives the bar's active trail).
    in property <int> workspace-direction: 1;
    in property <string> active-title;
    in property <string> active-app;
    // services
    in property <Status> status;
    in property <SysStats> sys;
    in property <MediaInfo> media;
    in property <Weather> weather;
    in property <string> weather-status: "loading"; // loading | ok | error
    in property <UserInfo> user;
    in property <bool> keep-awake;
    in property <bool> dnd;
    in property <[Recording]> recordings;
    in property <[AudioDevice]> audio-outputs;
    in property <[AudioDevice]> audio-inputs;
    in property <[BtDevice]> bt-devices;
    in property <[Place]> places;
    in property <string> place-status: "idle"; // idle | searching | none | error | detecting
    in property <string> cookie-path; // M3 expressive "cookie" shape, generated in Rust
    in property <string> komorebi-status: "stopped"; // not-installed | stopped | running | paused
    // plugins: widgets in the bar / dashboard, and every folder for Settings
    in property <[PluginWidget]> bar-plugins;
    in property <[PluginWidget]> dash-plugins;
    in property <[PluginWidget]> plugin-list;
    // Dots import from GitHub (Settings › About)
    in property <string> dots-state: "idle"; // idle | fetching | ready | applied | error
    in property <string> dots-text;
    in property <int> dots-wallpapers;
    in property <bool> dots-can-undo;
    in property <[string]> dots-recent;
    // Wallpaper download from GitHub (Settings › Wallpaper).
    in property <string> wallpaper-dl-state: "idle"; // idle | indexing | running | done | error
    in property <string> wallpaper-dl-text;
    in property <float> wallpaper-dl-progress;
    // config view
    in property <UiConfig> cfg: {
        bar-persistent: true, bar-show-workspaces: true, bar-workspaces-shown: 5, bar-active-trail: true,
        bar-show-active-window: true, bar-show-clock: true, bar-show-status: true, bar-show-power: true,
        bar-show-audio: true, bar-show-network: true, bar-show-bluetooth: true, bar-show-battery: true,
        clock-12h: true, dashboard-enabled: true, dashboard-show-on-hover: true,
        launcher-max-shown: 7, launcher-action-prefix: ">", clipboard-history: true, use-fahrenheit: false,
        wallpaper-enabled: true, scheme-variant: "tonalspot", scheme-mode: "dark", scheme-name: "dynamic", smart-scheme: true, anim-scale: 1, blur: true, super-launcher: false, wallpaper-repo: "", autostart: true, language: "en",
        border-thickness: 10, border-rounding: 25, rounding-scale: 1, font-scale: 1,
        transparency: false, base-alpha: 0.85, layer-alpha: 0.4,
        perf-mode: "auto", perf-on-battery: true, perf-on-fullscreen: true,
    };

    // UI -> Rust
    callback action(/* id */ string, /* arg */ string);
    callback set-config(/* dotted path */ string, /* JSON value */ string);
}
