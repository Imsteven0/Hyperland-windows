    VerticalLayout {
        spacing: 2px;
        ActionRow {
            first: true;
            title: @tr("Weather location");
            subtitle: Shell.cfg.weather-location == "" ? @tr("Automatic (IP)") : Shell.cfg.weather-location-name != "" ? Shell.cfg.weather-location-name : Shell.cfg.weather-location;
            icon: "location_on";
            button: @tr("Change");
            clicked => { Shell.action("settings-page", "7"); }
