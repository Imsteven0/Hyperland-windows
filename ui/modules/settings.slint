component LanguagePage inherits VerticalLayout {
    spacing: Theme.spacing-small;
    SectionLabel { text: @tr("UI language"); }
    HorizontalLayout {
        spacing: Theme.spacing-small;
        alignment: start;
        for l in [{ id: "auto", name: @tr("Automatic") }, { id: "en", name: "English" }, { id: "es", name: "Español" }]: Chip {
            text: l.name;
            selected: Shell.cfg.language == l.id;
            clicked => { Shell.set-config("general.language", "\"" + l.id + "\""); }
        }
