// Import dots from a GitHub link: preview first, then apply (with a backup
// to undo) and optionally download the repository's wallpapers.
component DotsGallery inherits Rectangle {
    property <bool> busy: Shell.dots-state == "fetching";
    property <bool> with-walls: true;
    border-radius: Theme.rounding-normal;
    background: Theme.layer(Theme.c.surface-container-high, 2);
    height: col.preferred-height;
    col := VerticalLayout {
        padding: Theme.padding-normal;
        padding-left: Theme.padding-larger;
        spacing: Theme.spacing-small;
        HorizontalLayout {
            spacing: Theme.spacing-normal;
            MaterialIcon { text: "travel_explore"; color: Theme.c.primary; }
            VerticalLayout {
                horizontal-stretch: 1;
                StyledText { text: @tr("Import from GitHub"); font-size: Theme.font-normal; }
                StyledText {
                    text: Shell.dots-text != "" ? Shell.dots-text : @tr("Finds shell.json, scheme.json and wallpapers in a repository");
                    font-size: Theme.font-small;
                    color: Shell.dots-state == "error" ? Theme.c.error : Theme.c.outline;
                    overflow: elide;
                }
            }
            TextButton {
                y: (parent.height - self.height) / 2;
                height: 32px;
                icon: root.busy ? "hourglass_top" : "search";
                text: @tr("Preview");
                font-size: Theme.font-small;
                clicked => { if !root.busy { Shell.action("dots-fetch", url.text); } }
            }
        }
        url := StyledInput {
            height: 40px;
            icon: "link";
            placeholder: "https://github.com/usuario/dots";
            font-size: Theme.font-normal;
            accepted(t) => { if !root.busy { Shell.action("dots-fetch", t); } }
        }
        if Shell.dots-recent.length > 0: HorizontalLayout {
            alignment: start;
            spacing: Theme.spacing-small;
            StyledText { text: @tr("Recent"); font-size: Theme.font-small; color: Theme.c.outline; }
            for r[i] in Shell.dots-recent: Rectangle {
                visible: i < 3;
                height: 26px;
                width: i < 3 ? min(180px, chip.preferred-width + 20px) : 0;
                border-radius: 13px;
                background: Theme.layer(Theme.c.secondary-container, 2);
                StateLayer { border-radius: parent.border-radius; clicked => { url.text = r; Shell.action("dots-fetch", r); } }
                chip := StyledText { x: 10px; width: parent.width - 20px; text: r; font-size: Theme.font-small; color: Theme.c.on-secondary-container; overflow: elide; }
            }
        }
        if Shell.dots-state == "ready": HorizontalLayout {
            spacing: Theme.spacing-small;
            if Shell.dots-wallpapers > 0: HorizontalLayout {
                spacing: Theme.spacing-small;
                StyledSwitch {
                    y: (parent.height - self.height) / 2;
                    checked: root.with-walls;
                    toggled(v) => { root.with-walls = v; }
                }
                StyledText { text: @tr("Also download its wallpapers"); font-size: Theme.font-small; color: Theme.c.on-surface-variant; }
            }
            Rectangle { horizontal-stretch: 1; }
            TextButton {
                height: 32px;
                icon: "check";
                text: @tr("Apply");
                kind: ButtonKind.filled;
                font-size: Theme.font-small;
                clicked => { Shell.action("dots-apply", root.with-walls && Shell.dots-wallpapers > 0 ? "wallpapers" : ""); }
            }
        }
        if Shell.dots-can-undo: HorizontalLayout {
            StyledText { horizontal-stretch: 1; text: @tr("Your previous dots were saved before importing"); font-size: Theme.font-small; color: Theme.c.outline; overflow: elide; }
            TextButton { height: 30px; icon: "undo"; text: @tr("Undo import"); kind: ButtonKind.outlined; font-size: Theme.font-small; clicked => { Shell.action("dots-undo", ""); } }
        }
    }
}

component AboutPage inherits VerticalLayout {
    in property <[InfoRow]> system;
    in property <[InfoRow]> software;
    in property <string> version;
    spacing: Theme.spacing-small;

    Rectangle {
        height: 150px;
        border-radius: Theme.rounding-large;
        background: Theme.layer(Theme.c.surface-container-high, 2);
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            MaterialIcon { text: "auto_awesome"; font-size: 54px; color: Theme.c.primary; fill: true; }
            StyledText { text: @tr("Caelestia"); font-size: 30px; horizontal-alignment: center; font-weight: 500; }
            StyledText { text: "v" + root.version + " · Windows"; font-size: Theme.font-small; color: Theme.c.outline; horizontal-alignment: center; }
        }
    }
    SectionLabel { text: @tr("Updates"); }
    upd := SettingRow {
        property <string> st: Shell.update-state;
        first: true;
        last: true;
        title: self.st == "available" ? @tr("Update available: {}", Shell.update-version)
            : self.st == "downloading" ? @tr("Downloading {}… {}%", Shell.update-version, Math.round(Shell.update-progress * 100))
            : self.st == "installing" ? @tr("Installing {}…", Shell.update-version)
            : self.st == "failed" ? @tr("Couldn't install the update")
            : self.st == "checking" ? @tr("Checking for updates…")
            : self.st == "current" ? @tr("You have the latest version")
            : self.st == "error" ? @tr("Couldn't check for updates")
            : @tr("Caelestia updates");
        subtitle: self.st == "available" || self.st == "downloading" ? @tr("Installs in the background and restarts Caelestia; your dots are kept")
            : self.st == "installing" ? @tr("Caelestia will close and open again in a moment")
            : self.st == "failed" ? @tr("Try again, or get the installer from GitHub")
            : @tr("Checked daily on GitHub Releases (general.checkUpdates)");
        HorizontalLayout {
            spacing: Theme.spacing-small;
            if upd.st == "downloading" || upd.st == "installing": LinearProgress {
                y: (parent.height - self.height) / 2;
                width: 140px;
                value: Shell.update-progress;
            }
            if upd.st == "available" || upd.st == "failed": TextButton {
                y: (parent.height - self.height) / 2;
                height: 32px;
                icon: upd.st == "failed" ? "refresh" : "download";
                text: upd.st == "failed" ? @tr("Retry") : @tr("Update");
                kind: ButtonKind.filled;
                font-size: Theme.font-small;
                clicked => { Shell.action("update-install", ""); }
            }
            if upd.st == "failed": IconButton {
                y: (parent.height - self.height) / 2;
                icon: "open_in_new";
                kind: ButtonKind.tonal;
                size: 32px;
                icon-size: Theme.font-larger;
                clicked => { Shell.action("update-open", ""); }
            }
            if upd.st == "available": IconButton {
                y: (parent.height - self.height) / 2;
                icon: "refresh";
                kind: ButtonKind.tonal;
                size: 32px;
                icon-size: Theme.font-larger;
                clicked => { Shell.action("update-check", ""); }
            }
            if upd.st != "available" && upd.st != "failed" && upd.st != "downloading" && upd.st != "installing": TextButton {
                y: (parent.height - self.height) / 2;
                height: 32px;
                icon: upd.st == "checking" ? "hourglass_top" : "refresh";
                text: @tr("Check now");
                kind: ButtonKind.outlined;
                font-size: Theme.font-small;
                clicked => { Shell.action("update-check", ""); }
            }
        }
    }
    SectionLabel { text: @tr("System"); }
    InfoTable { rows: root.system; }
    SectionLabel { text: @tr("Software"); }
    InfoTable { rows: root.software; }
    SectionLabel { text: @tr("Credits"); }
    VerticalLayout {
        spacing: 2px;
        ActionRow {
            first: true;
            title: @tr("Created by Steven Araya Gonzalez");
            subtitle: "github.com/Imsteven0";
            icon: "open_in_new";
            button: "GitHub";
            clicked => { Shell.action("open-uri", "https://github.com/Imsteven0"); }
        }
        ActionRow {
            last: true;
            title: @tr("Based on Caelestia");
            subtitle: @tr("The original Hyprland shell by the caelestia-dots project");
            icon: "open_in_new";
            button: "GitHub";
            clicked => { Shell.action("open-uri", "https://github.com/caelestia-dots/shell"); }
        }
    }
    SectionLabel { text: @tr("Dots"); }
    VerticalLayout {
        spacing: 2px;
        SettingRow { first: true; title: @tr("Config file"); subtitle: Shell.cfg.config-path; }
        ActionRow { title: @tr("Open config folder"); icon: "folder_open"; button: @tr("Open"); clicked => { Shell.action("open-config-dir", ""); } }
        ActionRow { title: @tr("Reload configuration"); icon: "refresh"; button: @tr("Reload"); clicked => { Shell.action("reload-config", ""); } }
        ActionRow { title: @tr("Export dots"); subtitle: @tr("shell.json + scheme.json as a shareable folder"); icon: "upload"; button: @tr("Export"); clicked => { Shell.action("dots-export", ""); } }
        ActionRow { last: true; title: @tr("Import dots"); subtitle: @tr("Apply someone else's shell.json"); icon: "download"; button: @tr("Import"); clicked => { Shell.action("dots-import", ""); } }
    }
    SectionLabel { text: @tr("Dots gallery"); }
    DotsGallery { }
}

// ---------------- window ----------------

export component SettingsWindow inherits Window {
    title: @tr("Caelestia Settings");
    no-frame: true;
    always-on-top: false;
    background: transparent;
    width: 885px;
    height: 625px;

    in-out property <int> page: 0;
    // Caelestia's AnimLoader: the old page fades out, swaps, the new one fades in.
    property <int> shown-page: 0; // set only by page-swap, never bound (it must lag)
    property <float> page-alpha: 1;
    animate page-alpha { duration: root.shown-page != root.page ? Theme.anim-fast-effects : Theme.anim-effects; easing: Motion.effects; }
    changed page => {
        root.page-alpha = 0;
        page-swap.running = true;
    }
    page-swap := Timer {
        interval: Math.max(1ms, Theme.anim-fast-effects);
        running: false;
        triggered => {
            self.running = false;
            root.shown-page = root.page;
            root.page-alpha = 1;
        }
    }
    in property <[bool]> nav-match;          // empty = everything matches
    in property <image> wallpaper-preview;
    in property <bool> has-wallpaper-preview;
    in property <[InfoRow]> about-system;
    in property <[InfoRow]> about-software;
    in property <string> version;
    in-out property <int> style-view;
    // Driven by Rust: true right after show(), false before hide().
    in-out property <bool> shown;
    in property <[SchemeCard]> schemes;
    in property <[WallpaperEntry]> wallpapers;
    in property <int> wallpapers-total;
    in property <string> wallpaper-dir;
    callback search(string);
    callback close-requested();
    callback drag();

    property <[NavItem]> nav: [
        { icon: "palette", title: @tr("Wallpaper & style"), subtitle: @tr("Wallpaper, fonts, colours"), group: 0 },
        { icon: "wifi", title: @tr("Network"), subtitle: @tr("Wi-Fi, ethernet"), group: 1 },
        { icon: "devices_other", title: @tr("Connected devices"), subtitle: @tr("Bluetooth, pairing"), group: 1 },
        { icon: "volume_up", title: @tr("Audio"), subtitle: @tr("App volumes, sound devices"), group: 1 },
        { icon: "update", title: @tr("Updates"), subtitle: @tr("System updates"), group: 2 },
        { icon: "extension", title: @tr("Plugins"), subtitle: @tr("Manage plugins"), group: 2 },
        { icon: "dock_to_left", title: @tr("Panels"), subtitle: @tr("Dashboard, taskbar, launcher, sidebar"), group: 3 },
        { icon: "build", title: @tr("Services"), subtitle: @tr("Weather location, units, clock"), group: 3 },
        { icon: "language", title: @tr("Language & region"), subtitle: @tr("UI language, weather location, display units"), group: 3 },
        { icon: "info", title: @tr("About"), subtitle: @tr("System information, credits"), group: 4 },
    ];

    // Shell shortcuts while Settings has focus (the global hook doesn't see them).
    FocusScope {
    focus-on-click: false;
    init => { self.focus(); } // keys reach it even before a field is clicked
    capture-key-pressed(e) => {
        if (e.modifiers.control || e.modifiers.alt || e.modifiers.meta) && Shell.hotkey(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta) { return accept; }
        reject
    }
    Rectangle {
        opacity: root.shown ? 1 : 0;
        transform-scale: root.shown ? 1 : 0.94;
        animate opacity { duration: Theme.anim-small; easing: cubic-bezier(0.2, 0, 0, 1); }
        animate transform-scale { duration: Theme.anim-normal; easing: cubic-bezier(0.05, 0.7, 0.1, 1); }
        border-radius: Theme.rounding-large;
        background: Theme.base;
        border-width: 1px;
        border-color: Theme.c.outline-variant.with-alpha(0.35);
        clip: true;

        HorizontalLayout {
            padding: Theme.padding-normal;
            spacing: Theme.spacing-normal;

            // ---------- navigation ----------
            VerticalLayout {
                width: 295px;
                spacing: Theme.spacing-small;
                StyledInput {
                    placeholder: @tr("Search settings");
                    font-size: Theme.font-normal;
                    edited(t) => { root.search(t); }
                }
                Flickable {
                    vertical-stretch: 1;
                    content-height: navcol.preferred-height;
                    navcol := VerticalLayout {
                        spacing: 2px;
                        for item[i] in root.nav: entry := Rectangle {
                            property <bool> matches: root.nav-match.length == 0 || root.nav-match[i];
                            property <bool> group-start: i == 0 || root.nav[i - 1].group != item.group;
                            property <bool> group-end: i == root.nav.length - 1 || root.nav[i + 1].group != item.group;
                            property <bool> active: root.page == i;
                            visible: self.matches;
                            height: self.matches ? 50px + (self.group-start && i > 0 ? Theme.spacing-small : 0) : 0;

                            Rectangle {
                                y: parent.height - self.height;
                                height: 50px;
                                border-top-left-radius: parent.group-start || parent.active ? Theme.rounding-normal : 4px;
                                border-top-right-radius: parent.group-start || parent.active ? Theme.rounding-normal : 4px;
                                border-bottom-left-radius: parent.group-end || parent.active ? Theme.rounding-normal : 4px;
                                border-bottom-right-radius: parent.group-end || parent.active ? Theme.rounding-normal : 4px;
                                background: parent.active ? Theme.layer(Theme.c.secondary-container, 3) : Theme.layer(Theme.c.surface-container, 2);
                                animate background { duration: Theme.anim-small; }

                                StateLayer {
                                    border-radius: parent.border-top-left-radius;
                                    clicked => { root.page = i; root.style-view = 0; }
                                }
                                HorizontalLayout {
                                    padding-left: Theme.padding-normal;
                                    spacing: Theme.spacing-normal;
                                    Rectangle {
                                        width: 34px;
                                        height: 34px;
                                        y: 8px;
                                        border-radius: Theme.rounding-full;
                                        background: entry.active ? Theme.c.primary : Theme.layer(Theme.c.surface-container-highest, 3);
                                        MaterialIcon {
                                            text: item.icon;
                                            fill: entry.active;
                                            font-size: Theme.font-larger;
                                            color: entry.active ? Theme.c.on-primary : Theme.c.on-surface-variant;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        StyledText { text: item.title; font-size: Theme.font-normal; }
                                        StyledText { text: item.subtitle; font-size: Theme.font-small; color: Theme.c.outline; overflow: elide; }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ---------- content ----------
            Rectangle {
                horizontal-stretch: 1;
                border-radius: Theme.rounding-normal;
                background: Theme.layer(Theme.c.surface-container, 2);
                clip: true;

                VerticalLayout {
                    padding: Theme.padding-large;
                    padding-top: Theme.padding-normal;
                    spacing: Theme.spacing-normal;

                    header := Rectangle {
                        height: 40px;
                        TouchArea {
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.drag(); }
                            }
                        }
                        StyledText {
                            x: 0;
                            text: root.nav[root.page].title;
                            font-size: Theme.font-large + 2px;
                        }
                        IconButton {
                            x: parent.width - self.width + Theme.padding-small;
                            y: (parent.height - self.height) / 2;
                            icon: "close";
                            size: 28px;
                            icon-size: Theme.font-larger;
                            clicked => { root.close-requested(); }
                        }
                    }

                    Flickable {
                        vertical-stretch: 1;
                        content-height: pagecol.preferred-height;
                        pagecol := VerticalLayout {
                            opacity: root.page-alpha;
                            padding-bottom: Theme.padding-large;
                            if root.shown-page == 0: WallpaperPage {
                                preview: root.wallpaper-preview;
                                has-preview: root.has-wallpaper-preview;
                                schemes: root.schemes;
                                wallpapers: root.wallpapers;
                                total: root.wallpapers-total;
                                wallpaper-dir: root.wallpaper-dir;
                                view <=> root.style-view;
                            }
                            if root.shown-page == 1: NetworkPage { }
                            if root.shown-page == 2: DevicesPage { }
                            if root.shown-page == 3: AudioPage { }
                            if root.shown-page == 4: UpdatesPage { }
                            if root.shown-page == 5: PluginsPage { }
                            if root.shown-page == 6: PanelsPage { }
                            if root.shown-page == 7: ServicesPage { }
                            if root.shown-page == 8: LanguagePage { }
                            if root.shown-page == 9: AboutPage { system: root.about-system; software: root.about-software; version: root.version; }
                        }
                    }
                }
            }
        }
    }
    }
}
